{
  "name": "smartjc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-prompts.ts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "biome format --write src tests scripts",
    "format:check": "biome format src tests scripts",
    "lint": "biome lint src tests scripts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "check:browser": "node tests/browser.mjs",
    "check:pwa": "node tests/pwa.mjs",
    "check:settings": "node tests/model-settings.mjs",
    "check:responses-live": "node tests/model-responses-live.mjs",
    "check:legacy": "node tests/legacy-editor.mjs",
    "check:m15:browser": "node tests/m15-browser.mjs",
    "check:m15:live": "node tests/m15-live.mjs",
    "check:m16:browser": "node tests/m16-browser.mjs",
    "check:m16:live": "node tests/m16-live.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.41.0",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.0"
  }
}
